# Copy to .env.local and fill in. Never commit the real file.

# Your Claude API key from the Claude Console. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Optional: low, medium or high. Lower is faster and cheaper.
AGENT_EFFORT=medium

# Optional: shown as "Built by ..." in the footer.
NEXT_PUBLIC_BUILDER_NAME=
NEXT_PUBLIC_BUILDER_URL=
